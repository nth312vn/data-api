APP_NAME=data-api
APP_VERSION=0.1.0
ENVIRONMENT=local
DEBUG=false
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/data_api
PII_DATABASE_URL=postgresql+asyncpg://postgres:postgres@pii-db:5432/pii_mapping
WAIT_FOR_DATABASE=true
DATABASE_CONNECT_TIMEOUT_SECONDS=60
DATABASE_CONNECT_RETRY_SECONDS=2
RUN_MIGRATIONS=true
RUN_INITIAL_ADMIN=true

JWT_SECRET_KEY=replace-this-with-a-random-64-character-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080
PASSWORD_BCRYPT_ROUNDS=12

CORS_ORIGINS=http://localhost:3000,http://localhost:8000
LOG_LEVEL=INFO

TRINO_HOST=trino
TRINO_PORT=8080
TRINO_USER=data-api
TRINO_PASSWORD=
TRINO_HTTP_SCHEME=http

PII_MAPPING_MISSING_TTL_SECONDS=60
PII_MAPPING_SNAPSHOT_BATCH_SIZE=500
